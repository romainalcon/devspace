{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevSpace",
  "identifier": "me.romainalcon.devspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevSpace",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFNUYyMzk0NjRBMDk0QjIKUldTeWxLQmtsQ05mbmllYk1wcmxhMVo4RTNZOGpQVk1OU3pXU1JVV3Y2Nmpuakg3UDhJN3FmOFAK",
      "endpoints": [
        "https://github.com/romainalcon/devspace/releases/latest/download/latest.json"
      ]
    }
  }
}
